<resources>
    <style name="Theme.Semo" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/semo_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:colorAccent">@color/semo_accent</item>
