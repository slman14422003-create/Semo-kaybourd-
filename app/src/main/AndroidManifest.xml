<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- يعلن أن التطبيق يوفّر لوحة مفاتيح (IME) -->
    <uses-feature
        android:name="android.software.input_methods"
        android:required="true" />

    <!-- الاهتزاز الخفيف عند الضغط على المفاتيح (الصلاحية الوحيدة المطلوبة، وهي عادية ولا تُسأل من المستخدم) -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <queries>
        <intent>
            <action android:name="app.semo.ECOSYSTEM" />
        </intent>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />

    <!-- للزر اليدوي «تنزيل القاموس الكبير» وللتحقق من التحديثات بإعدادات التطبيق فقط؛ خدمة لوحة المفاتيح نفسها لا تتصل بالإنترنت -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- تثبيت تحديث التطبيق المُنزَّل من ريليس جيتهاب (يُطلب من المستخدم عند أول استخدام فقط) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.Semo"
        android:supportsRtl="true">

        <!-- Semo ecosystem: what this app is, so the other Semo apps can find and use it -->
        <meta-data android:name="app.semo.ROLE" android:value="keyboard" />


        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Semo">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.INFO" />
            </intent-filter>
            <intent-filter>
                <action android:name="app.semo.ECOSYSTEM" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- alias منفصل حامل أيقونة الإطلاق: تعطيله (AppIconVisibility) يخفي أيقونة
             التطبيق من الشاشة الرئيسية وشاشة التطبيقات دون التأثير على MainActivity نفسه
             أو على خدمة لوحة المفاتيح. -->
        <activity-alias
            android:name=".ui.MainActivityLauncher"
            android:targetActivity=".ui.MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".ime.VoicePermissionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Semo.Transparent" />

        <service
            android:name=".ime.SemoKeyboardService"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:exported="true"
            android:directBootAware="true"
            android:label="@string/app_name"
            android:settingsActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!-- مشاركة صور الحافظة المحفوظة مع التطبيق الذي نلصق فيه (commitContent) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.clipfiles"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/clip_file_paths" />
        </provider>

    </application>
</manifest>
